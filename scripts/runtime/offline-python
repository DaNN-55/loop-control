#!/bin/sh
set -eu
runtime_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.loop-control/local" && pwd)
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 HF_HUB_DISABLE_IMPLICIT_TOKEN=1 DO_NOT_TRACK=1 TOKENIZERS_PARALLELISM=false
export NLTK_DATA="$runtime_root/volume/media/whisperx-models/nltk_data"
export NUMBA_CACHE_DIR="$runtime_root/python/numba-cache"
exec /usr/bin/sandbox-exec -p '(version 1)(allow default)(deny network*)' "$runtime_root/python/venv/bin/python" -B "$@"
