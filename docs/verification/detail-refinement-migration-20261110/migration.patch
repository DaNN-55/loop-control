@@ -0,0 +1,72 @@
+/* Approved detail refinement: spacing/alignment, typography/numerals and state colors.
+   Scope to shot preparation, image/video generation and account common rules. */
+html[data-interface="impeccable"] .product-ui [data-compact-workflow] .workspace-preparation > header {
+  padding: 14px 16px; gap: 16px;
+}
+html[data-interface="impeccable"] .product-ui .workspace-preparation-heading h3 {
+  font-size: 16px; font-weight: 600; line-height: 1.5; letter-spacing: 0;
+}
+html[data-interface="impeccable"] .product-ui .workspace-preparation-heading > span {
+  font-size: 12px; line-height: 1.6; font-variant-numeric: tabular-nums lining-nums;
+  background: transparent;
+}
+html[data-interface="impeccable"] .product-ui .workspace-preparation-detail > #preparation-panel-visual { padding: 16px; }
+html[data-interface="impeccable"] .product-ui .workspace-table-caption { padding: 14px 16px; }
+html[data-interface="impeccable"] .product-ui .workspace-shot-table :is(th,td) { padding: 12px 10px; vertical-align: middle; }
+html[data-interface="impeccable"] .product-ui .workspace-shot-table :is(th,td):first-child { padding-left: 16px; }
+html[data-interface="impeccable"] .product-ui .workspace-shot-table :is(th,td):nth-child(3) {
+  text-align: right; white-space: nowrap; padding-right: 16px; font-variant-numeric: tabular-nums lining-nums;
+}
+html[data-interface="impeccable"] .product-ui .workspace-shot-table :is(td,td:first-child button) { font-size: 12px; line-height: 1.6; }
+html[data-interface="impeccable"] .product-ui .workspace-shot-table th { font-size: 12px; font-weight: 500; line-height: 1.5; }
+html[data-interface="impeccable"] .product-ui .workspace-shot-text > span { font-size: 13px; line-height: 1.6; }
+html[data-interface="impeccable"] .product-ui .workspace-shot-text > small { margin-top: 4px; font-size: 12px; line-height: 1.5; }
+html[data-interface="impeccable"] .product-ui .workspace-shot-table [data-narration-tone="neutral"] { color: var(--lc-muted); }
+html[data-interface="impeccable"] .product-ui .workspace-shot-table [data-narration-tone="busy"] { color: var(--lc-accent); }
+html[data-interface="impeccable"] .product-ui .workspace-shot-table [data-narration-tone="error"] { color: var(--lc-danger); }
+html[data-interface="impeccable"] .product-ui .workspace-table-footer {
+  padding: 12px 16px; font-size: 12px; line-height: 1.6; font-variant-numeric: tabular-nums lining-nums;
+}
+html[data-interface="impeccable"] .product-ui .workspace-visual-unified .workspace-result-footer { padding-block: 12px; align-items: center; }
+html[data-interface="impeccable"] .product-ui .workspace-visual-unified .workspace-candidate-source { font-size: 12px; line-height: 1.6; }
+html[data-interface="impeccable"] .product-ui .workspace-generation-composer[data-operation="generate"] { padding: 16px; gap: 12px; }
+html[data-interface="impeccable"] .product-ui .workspace-generation-composer[data-operation="generate"] .workspace-composer-toolbar { gap: 8px; align-items: center; }
+html[data-interface="impeccable"] .product-ui .workspace-generation-composer[data-operation="generate"] .workspace-composer-toolbar :is(button,.workspace-composer-kind) { min-height: 32px; padding-block: 6px; }
+html[data-interface="impeccable"] .product-ui .workspace-generation-composer[data-operation="generate"] :is(.workspace-composer-chip,.workspace-composer-kind) {
+  font-size: 12px !important; line-height: 20px; font-weight: 500;
+}
+html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-editor-heading:has(+ .account-configuration-form) { padding: 20px 24px; align-items: center; }
+html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-editor-heading:has(+ .account-configuration-form) h2,
+html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-form > fieldset > legend {
+  font-size: 16px; font-weight: 600; line-height: 1.5; letter-spacing: 0;
+}
+html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-form > fieldset,
+html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-form .creative-rule-fields { gap: 20px; }
+html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-form > fieldset { padding: 20px 24px; }
+html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-form label:has(> textarea,> [role="group"]) {
+  grid-template-columns: 124px minmax(0,1fr); gap: 20px; align-items: start;
+}
+html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-form label:has(> [role="group"]) { align-items: center; }
+html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-form label:has(> textarea) > .field-label { grid-column: 1; grid-row: 1; }
+html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-form label > textarea { grid-column: 2; grid-row: 1; }
+html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-form .field-label { font-size: 13px; line-height: 1.6; font-weight: 500; }
+html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-form textarea { font-size: 13px; line-height: 1.7; font-weight: 400; }
+html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-footer { padding: 20px 24px; gap: 12px; align-items: center; }
+html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-footer .configuration-actions { gap: 12px; }
+html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-editor-heading:has(+ .account-configuration-form) .account-save-state,
+html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-form .account-save-state {
+  font-size: 12px; line-height: 1.6; font-variant-numeric: tabular-nums lining-nums;
+}
+html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-editor-heading:has(+ .account-configuration-form) .account-save-state { color: var(--lc-success); }
+html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-form .account-save-state.is-dirty { color: var(--lc-warning); }
+@media(max-width:640px) {
+  html[data-interface="impeccable"] .product-ui .workspace-preparation-detail > #preparation-panel-visual,
+  html[data-interface="impeccable"] .product-ui .workspace-generation-composer[data-operation="generate"] { padding: 12px; }
+  html[data-interface="impeccable"] .product-ui .workspace-shot-table :is(th,td) { padding-inline: 8px; }
+  html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-editor-heading:has(+ .account-configuration-form),
+  html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-form > fieldset,
+  html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-footer { padding: 16px; }
+  html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-form label:has(> textarea,> [role="group"]) { grid-template-columns: minmax(0,1fr); gap: 8px; }
+  html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-form label > textarea,
+  html[data-interface="impeccable"] .product-ui .account-blueprint-workspace .account-blueprint-form label:has(> textarea) > .field-label { grid-column: 1; grid-row: auto; }
+}
