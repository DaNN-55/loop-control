  "cues": [
    {
      "id": "phrase-1",
      "text": "我冒了严寒，",
      "startMs": 160,
      "endMs": 580,
      "confidence": 0.4468
    },
    {
      "id": "phrase-2",
      "text": "回到相隔二千余里，",
      "startMs": 600,
      "endMs": 1320,
      "confidence": 0.3455
    },
    {
      "id": "phrase-3",
      "text": "别了二十余年的故乡去。",
      "startMs": 1340,
      "endMs": 2201,
      "confidence": 0.2666
    },
    {
      "id": "phrase-4",
      "text": "时候既然是深冬；",
      "startMs": 2221,
      "endMs": 2361,
      "confidence": 0
    },
    {
      "id": "phrase-5",
      "text": "渐近故乡时，",
      "startMs": 2381,
      "endMs": 2481,
      "confidence": 0
    },
    {
      "id": "phrase-6",
      "text": "天气又阴晦了，",
      "startMs": 2501,
      "endMs": 3001,
      "confidence": 0.43766666666666665
    },
    {
      "id": "phrase-7",
      "text": "冷风吹进船舱中，",
      "startMs": 3021,
      "endMs": 3361,
      "confidence": 0.19985714285714287
    },
    {
      "id": "phrase-8",
      "text": "呜呜的响，",
      "startMs": 3401,
      "endMs": 3481,
      "confidence": 0.49924999999999997
    },
    {
      "id": "phrase-9",
      "text": "从篷隙向外一望，",
      "startMs": 3501,
      "endMs": 4161,
      "confidence": 0.12528571428571428
    },
    {
      "id": "phrase-10",
      "text": "苍黄的天底下，",
      "startMs": 4221,
      "endMs": 4441,
      "confidence": 0.26216666666666666
    },
    {
      "id": "phrase-11",
      "text": "远近横着几个萧索的荒村，",
      "startMs": 4581,
      "endMs": 5261,
      "confidence": 0.32618181818181813
    },
    {
      "id": "phrase-12",
      "text": "没有一些活气。",
      "startMs": 5301,
      "endMs": 5882,
      "confidence": 0.4486666666666667
    },
    {
      "id": "phrase-13",
      "text": "我的心禁不住悲凉起来了。",
      "startMs": 5982,
      "endMs": 6422,
      "confidence": 0.1970909090909091
    },
    {
      "id": "phrase-14",
      "text": "啊！",
      "startMs": 6442,
      "endMs": 6462,
      "confidence": 0
    },
    {
      "id": "phrase-15",
      "text": "这不是我二十年来时时记得的故乡？",
      "startMs": 6482,
      "endMs": 6782,
      "confidence": 0
    },
    {
      "id": "phrase-16",
      "text": "我所记得的故乡全不如此。",
      "startMs": 6802,
      "endMs": 7022,
      "confidence": 0
    },
    {
      "id": "phrase-17",
      "text": "我的故乡好得多了。",
      "startMs": 7482,
      "endMs": 7842,
      "confidence": 0.23049999999999998
    },
    {
      "id": "phrase-18",
      "text": "但要我记起它的美丽，",
      "startMs": 7862,
      "endMs": 8142,
      "confidence": 0.1443333333333333
    },
    {
      "id": "phrase-19",
      "text": "说出它的佳处来，",
      "startMs": 8222,
      "endMs": 8522,
      "confidence": 0.127
    },
    {
      "id": "phrase-20",
      "text": "却又没有影像，",
      "startMs": 8542,
      "endMs": 8963,
      "confidence": 0.41933333333333334
    },
    {
      "id": "phrase-21",
      "text": "没有言辞了。",
      "startMs": 8983,
      "endMs": 9123,
      "confidence": 0.1332
    },
    {
      "id": "phrase-22",
      "text": "仿佛也就如此。",
      "startMs": 9143,
      "endMs": 9343,
      "confidence": 0.12616666666666668
    },
    {
      "id": "phrase-23",
      "text": "于是我自己解释说：",
      "startMs": 9363,
      "endMs": 9583,
      "confidence": 0.09375
    },
    {
      "id": "phrase-24",
      "text": "故乡本也如此，",
      "startMs": 9623,
      "endMs": 9743,
      "confidence": 0
    },
    {
      "id": "phrase-25",
      "text": "——虽然没有进步，",
      "startMs": 9803,
      "endMs": 10023,
      "confidence": 0.13883333333333334
    },
    {
      "id": "phrase-26",
      "text": "也未必有如我所感的悲凉，",
      "startMs": 10043,
      "endMs": 10463,
      "confidence": 0.14236363636363636
    },
    {
      "id": "phrase-27",
      "text": "这只是我自己心情的改变罢了，",
      "startMs": 10483,
      "endMs": 10863,
      "confidence": 0.11546153846153848
    },
    {
      "id": "phrase-28",
      "text": "因为我这次回乡，",
      "startMs": 10923,
      "endMs": 11203,
      "confidence": 0.21942857142857145
    },
    {
      "id": "phrase-29",
      "text": "本没有什么好心绪。",
      "startMs": 11223,
      "endMs": 11523,
      "confidence": 0.281875
