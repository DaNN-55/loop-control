        "confidence": 0.2666
      },
      {
        "id": "phrase-4",
        "text": "时候既然是深冬；",
        "endMs": 2361,
        "startMs": 2221,
        "confidence": 0
      },
      {
        "id": "phrase-5",
        "text": "渐近故乡时，",
        "endMs": 2481,
        "startMs": 2381,
        "confidence": 0
      },
      {
        "id": "phrase-6",
        "text": "天气又阴晦了，",
