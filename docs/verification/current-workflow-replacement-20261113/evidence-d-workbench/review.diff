+type Row<K extends keyof Database['public']['Tables']>=Database['public']['Tables'][K]['Row'];
+interface LegacyWorkbenchRecord {
+ version:'legacy-shot-workbench/v1';episodeId:string;scriptRevisionId:string|null;
+ board:Row<'review_packages'>;drafts:Array<Row<'shot_preparation_drafts'>&{preparation_input_fingerprint:string|null;current_audio_track_id:string|null;current_video_artifact_id:string|null;current_video_task_id:string|null}>;tasks:Array<Row<'tasks'>&{invalidated_at:string|null}>;
