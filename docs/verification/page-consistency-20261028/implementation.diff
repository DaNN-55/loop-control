+                    <Icon aria-hidden className="dan-select-option-icon" />
+                    <span>{item.id}</span>
+                    <Check aria-hidden className="dan-select-option-check" />
+                </ListBoxItem>}
+            </ListBox>
+        </Popover>
+    </div>;
