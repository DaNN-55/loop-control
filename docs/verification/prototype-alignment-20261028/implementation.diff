@@ -0,0 +1,41 @@
+import {AlertCircle,CheckCircle2,Clock3,LoaderCircle,PencilLine} from 'lucide-react';
+import type {EpisodeCatalog} from '../episodes/episodeCatalogTypes';
+import type {EpisodeStage} from '../platform/types';
+import type {Database} from '../lib/database.types';
+
+type Episode=Database['public']['Tables']['episodes']['Row'];
+export type EpisodeActionState='draft'|'review'|'running'|'blocked'|'done';
+export type EpisodeRowSummary=EpisodeCatalog['operationRows'][number];
+const states={draft:{label:'准备中',icon:PencilLine},review:{label:'待审核',icon:Clock3},running:{label:'制作中',icon:LoaderCircle},blocked:{label:'需处理',icon:AlertCircle},done:{label:'已完成',icon:CheckCircle2}};
+export function episodeActionState(episode:Episode,summary?:EpisodeRowSummary):EpisodeActionState {
+ if(summary?.actionStatus)return summary.actionStatus;
+ if(summary?.blockerCount)return 'blocked';
+ if(summary?.reviewPending)return 'review';
+ if(episode.stage==='production_completed')return 'done';
+ return ['waiting_input','brief_draft','script_draft'].includes(episode.stage)?'draft':'running';
+}
+export function EpisodeStatus({state}:{state:EpisodeActionState}){const {label,icon:Icon}=states[state];return <span className={`episode-state episode-state-${state}`}><Icon aria-hidden="true" size={14}/>{label}</span>;}
+export function episodeNextAction(episode:Episode,state:EpisodeActionState){
+ if(state==='blocked')return {label:'处理阻塞',detail:'查看当前问题，处理后继续制作。'};
+ if(state==='review')return {label:'继续审核',detail:'查看本次证据，决定通过或提出修改。'};
+ if(state==='done')return {label:'查看交付包',detail:'核对成片与已保存的交付文件。'};
+ const next:Partial<Record<EpisodeStage,{label:string;detail:string}>>={
+  waiting_input:{label:'准备脚本与素材',detail:'补充本期输入，确认后开始制作。'},
+  brief_draft:{label:'继续准备输入',detail:'检查本期要求与已上传材料。'},
+  script_draft:{label:'继续准备脚本',detail:'核对当前脚本和所需材料。'},
+  visual_draft:{label:'继续视觉准备',detail:'检查视觉方案和当前任务。'},
+  storyboard_draft:{label:'继续分镜规划',detail:'检查分镜方案和当前任务。'},
+  render_ready:{label:'查看合成进度',detail:'查看当前任务与已有预览。'},
+  qc_passed:{label:'检查并完成交付',detail:'核对通过 QC 的成片及交付文件。'},
+ };
+ return next[episode.stage]??{label:'继续制作',detail:'打开生产单，接着完成当前阶段。'};
+}
+export const episodePhaseGroups:Array<{label:string;stages:EpisodeStage[]}>= [
+ {label:'输入',stages:['waiting_input','brief_draft','script_draft','script_review','script_approved']},
+ {label:'视觉',stages:['visual_draft','visual_review','visual_approved']},
+ {label:'分镜',stages:['storyboard_draft','storyboard_review']},
+ {label:'镜头',stages:['storyboard_approved','production_ready']},
+ {label:'合成',stages:['render_ready']},
+ {label:'QC',stages:['qc_review','qc_passed']},
+ {label:'交付',stages:['production_completed']},
+];
