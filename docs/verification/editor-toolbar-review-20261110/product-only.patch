+.embedded-studio > .embedded-studio-header .embedded-studio-save:hover:not(:disabled) {background:var(--lc-accent-hover,#254fc9);border-color:var(--lc-accent-hover,#254fc9);}
+.embedded-studio-header svg {flex:none;}
