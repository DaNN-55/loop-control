-.workspace-script-input-help{display:grid;gap:8px;margin-block:12px;font-size:12px;line-height:1.6}
-.workspace-script-input-help summary{cursor:pointer;color:var(--lc-muted)}
-.workspace-script-input-help pre{white-space:pre-wrap;overflow-wrap:anywhere}
-.workspace-script-input-help article{padding-block:10px;border-bottom:1px solid var(--lc-line)}
-.workspace-script-input-help dl{margin-block:6px 0}.workspace-script-input-help dt{color:var(--lc-muted)}
-.workspace-script-input-help dd{margin:0;white-space:pre-wrap;overflow-wrap:anywhere}
+.workspace-script-main{container:script-input / inline-size}
+.workspace-script-comparison{display:grid;grid-template-columns:minmax(0,3fr) minmax(0,2fr);gap:16px;flex:1;min-height:340px}
+.workspace-script-editor{display:flex;flex-direction:column;gap:12px;min-width:0;min-height:0}
+.workspace-script-editor-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:32px;font-size:13px;font-weight:600;color:var(--lc-ink)}
+.workspace-script-shot-preview{min-width:0;padding:0 0 0 16px;border-left:1px solid var(--lc-line);overflow-wrap:anywhere}
+.workspace-script-shot-preview>header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;min-height:32px;margin-bottom:12px}
+.workspace-script-shot-preview h4{margin:0;font-size:13px;font-weight:600;color:var(--lc-ink)}
+.workspace-script-shot-preview>header>span,.workspace-script-preview-message{margin:0;font-size:12px;color:var(--lc-muted)}
+.workspace-script-shot-preview article{padding-block:16px;border-bottom:1px solid var(--lc-line);font-size:13px;line-height:1.7}
+.workspace-script-shot-preview article:first-of-type{padding-top:0}
+.workspace-script-shot-preview article:last-child{border-bottom:0}
+.workspace-script-shot-preview article>strong{font-size:12px;font-weight:600;color:var(--lc-muted)}
+.workspace-script-shot-preview dl{display:grid;gap:12px;margin:8px 0 0}
+.workspace-script-shot-preview dt{font-size:12px;color:var(--lc-muted)}
+.workspace-script-shot-preview dd{margin:4px 0 0;white-space:pre-wrap;overflow-wrap:anywhere;color:var(--lc-ink)}
+@container script-input (max-width:640px){
+ .workspace-script-comparison{grid-template-columns:minmax(0,1fr);flex:0 0 auto}
+ .workspace-script-shot-preview{padding:16px 0 0;border-left:0;border-top:1px solid var(--lc-line)}
+}
