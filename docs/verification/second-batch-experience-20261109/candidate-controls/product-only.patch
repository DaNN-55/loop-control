+.workspace-candidate-tools :is(button,a){position:static!important;box-sizing:border-box;display:inline-flex;align-items:center;justify-content:center;gap:4px;width:32px;min-width:32px;min-height:32px;height:32px;padding:6px!important;border:0!important;box-shadow:none!important;border-radius:6px;background:var(--lc-surface)!important;color:var(--lc-muted);font-size:12px!important}
+.workspace-candidate-tools .workspace-candidate-tool-first-frame{width:auto;padding-inline:8px!important;color:var(--lc-ink)}
+.workspace-candidate-tools :is(button,a):hover:not(:disabled){background:var(--lc-accent-soft)!important;color:var(--lc-accent)}
+html[data-interface="impeccable"] .product-ui .workspace-candidate-tools .workspace-candidate-tool-remove:is(:hover,[data-hovered]):not(:disabled){background:var(--lc-danger-soft)!important;color:var(--lc-danger)!important}
+html[data-interface="impeccable"] .product-ui .workspace-candidate-tools .workspace-candidate-tool-remove:is(:hover,[data-hovered]):not(:disabled) svg{color:inherit!important}
+.workspace-candidate-tools :is(button,a):focus-visible{outline:2px solid var(--lc-accent);outline-offset:2px}
+.workspace-result-footer .workspace-candidate-used-status{color:var(--lc-success)}
+.workspace-result-actions>.workspace-candidate-withdraw,.workspace-result-actions>.workspace-candidate-replace{border:0!important;background:transparent!important;padding-inline:0!important;box-shadow:none!important;font-size:12px!important;color:var(--lc-muted)!important}
+.workspace-result-actions>.workspace-candidate-withdraw:hover,.workspace-result-actions>.workspace-candidate-replace:hover{color:var(--lc-accent)!important}
+.workspace-candidate-source{font-size:12px;color:var(--lc-muted);overflow-wrap:anywhere}
+.workspace-candidate-trim-popover .workspace-adoption-settings{display:grid;gap:12px}
+.workspace-candidate-trim-popover .workspace-visual-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
+@media(pointer:coarse){.workspace-candidate-tools :is(button,a){min-width:40px;min-height:40px;height:40px}}
