+import {historySize} from '../local-app/historyPresentation';
+
 export interface DeletionFileScope {
  files?:{path:string;bytes:number;authority:string}[];
  preserved?:{path:string;reason:string}[];
 }
-/** All permanent-delete entry points show the same server-confirmed file scope. */
-export function EpisodeDeletionScope({files,preserved}:DeletionFileScope){return<>
- {files&&<details open><summary>将删除 {files.length} 个已登记文件</summary><ul className="episode-deletion-paths" aria-label="将删除的生产单文件">{files.map(file=><li key={file.path}><code>{file.path}</code></li>)}</ul></details>}
- {Boolean(preserved?.length)&&<details open><summary>保留 {preserved!.length} 项</summary><ul className="episode-deletion-paths" aria-label="保留的生产单文件">{preserved!.map(file=><li key={file.path}><code>{file.path}</code><small>{file.reason}</small></li>)}</ul></details>}
- </>;}
+/** Summarize the server-confirmed plan; sizes describe files, not disk space reclaimed. */
+export function EpisodeDeletionScope({files,preserved}:DeletionFileScope){
+ if(!files&&!preserved?.length)return null;
+ const groups=new Map<string,NonNullable<DeletionFileScope['preserved']>>();
+ for(const item of preserved??[]){
+  const group=groups.get(item.reason);
+  if(group)group.push(item);else groups.set(item.reason,[item]);
+ }
+ return <section className="episode-deletion-scope" aria-label="文件范围摘要">
+  {files&&<>
+   <p className="episode-deletion-summary"><strong>将删除 {files.length} 个文件</strong><span>共 {historySize(files.reduce((total,file)=>total+file.bytes,0))}</span></p>
+   {files.length>0&&<details><summary>查看文件明细</summary><ul className="episode-deletion-paths" aria-label="将删除的生产单文件">{files.map(file=><li key={file.path}><code>{file.path}</code><span className="episode-deletion-file-size">{historySize(file.bytes)}</span></li>)}</ul></details>}
+  </>}
+  {Boolean(preserved?.length)&&<section className="episode-deletion-preserved" aria-label="保留内容">
+   <h3>保留 {preserved!.length} 项</h3>
+   {[...groups].map(([reason,items])=><details key={reason}><summary>{reason}<span className="episode-deletion-reason-count">{items.length} 项</span></summary><ul className="episode-deletion-paths" aria-label={reason}>{items.map(file=><li key={file.path}><code>{file.path}</code></li>)}</ul></details>)}
+  </section>}
+ </section>;
+}
