  "components": [
    {
      "name": "Button / primary",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "原生 sm 动作按钮的静态外观；主按钮文字与图标共用语义墨色。",
      "html": "<button class=\"ds-button-primary\" type=\"button\">批准</button>",
      "css": ".ds-button-primary{font-family:var(--font-body,-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif);font-size:13px;border-radius:7px;padding:8px 12px;font-weight:600;line-height:20px;cursor:pointer;transition:background-color .15s,color .15s,border-color .15s;background:var(--lc-accent,#365fe0);color:var(--lc-primary-ink,#fff);border:1px solid transparent}.ds-button-primary:hover{background:var(--lc-accent-hover,#254fc9)}.ds-button-primary:focus-visible{outline:2px solid var(--lc-accent,#365fe0);outline-offset:3px;}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
    },
    {
      "name": "Button / secondary",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "原生 sm 动作按钮的静态外观；主按钮文字与图标共用语义墨色。",
      "html": "<button class=\"ds-button-secondary\" type=\"button\">返回工作区</button>",
      "css": ".ds-button-secondary{font-family:var(--font-body,-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif);font-size:13px;border-radius:7px;padding:8px 12px;font-weight:600;line-height:20px;cursor:pointer;transition:background-color .15s,color .15s,border-color .15s;background:var(--lc-surface,#fff);color:var(--lc-ink,#17263e);border:1px solid var(--lc-line-strong,#bdcadd)}.ds-button-secondary:hover{background:var(--lc-surface-2,#f7f9fc)}.ds-button-secondary:focus-visible{outline:2px solid var(--lc-accent,#365fe0);outline-offset:3px;}.ds-button-secondary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none}}"
    },
    {
      "name": "Button / tertiary",
      "kind": "button",
      "refersTo": "button-tertiary",
      "description": "原生 sm 动作按钮的静态外观；主按钮文字与图标共用语义墨色。",
      "html": "<button class=\"ds-button-tertiary\" type=\"button\">查看详情</button>",
      "css": ".ds-button-tertiary{font-family:var(--font-body,-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif);font-size:13px;border-radius:7px;padding:8px 12px;font-weight:600;line-height:20px;cursor:pointer;transition:background-color .15s,color .15s,border-color .15s;background:transparent;color:var(--lc-muted,#596b83);border:1px solid transparent}.ds-button-tertiary:hover{background:var(--lc-surface-2,#f7f9fc)}.ds-button-tertiary:focus-visible{outline:2px solid var(--lc-accent,#365fe0);outline-offset:3px;}.ds-button-tertiary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-tertiary{transition:none}}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "有标签的紧凑字段，保留焦点与禁用反馈。",
      "html": "<label class=\"ds-field\">邮箱<input class=\"ds-input\" type=\"email\" autocomplete=\"off\"></label>",
      "css": ".ds-field{font-family:var(--font-body,-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif);font-size:13px;display:grid;gap:7px;color:var(--lc-ink,#17263e);max-width:360px}.ds-input{font-family:var(--font-body,-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif);font-size:13px;border:1px solid var(--lc-line-strong,#bdcadd);border-radius:7px;background:var(--lc-surface,#fff);color:var(--lc-ink,#17263e);padding:8px 12px;line-height:20px}.ds-input:focus-visible{outline:2px solid var(--lc-accent,#365fe0);outline-offset:3px;}.ds-input:disabled{opacity:.5}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "固定钴蓝侧栏中的活动与普通入口。",
      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><button class=\"ds-nav-item ds-nav-active\" aria-current=\"page\">工作台</button><button class=\"ds-nav-item\">生产单</button><button class=\"ds-nav-item\">待审核</button></nav>",
      "css": ".ds-nav{display:grid;gap:5px;background:var(--lc-rail,#173e8f);padding:14px;width:172px}.ds-nav-item{font-family:var(--font-body,-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif);font-size:13px;border:0;border-radius:7px;min-height:40px;padding:10px 12px;text-align:left;background:transparent;color:var(--lc-rail-ink,#e8efff);cursor:pointer}.ds-nav-item:hover{background:#ffffff14}.ds-nav-item.ds-nav-active{background:#ffffff21;color:#fff;font-weight:600}.ds-nav-item:focus-visible{outline:2px solid var(--lc-rail-ink,#e8efff);outline-offset:2px}"
    },
    {
      "name": "Pending status",
      "kind": "chip",
      "refersTo": "status-pending",
      "description": "真实待审核状态的文字与底色。",
      "html": "<span class=\"ds-status\" role=\"status\">待审核</span>",
      "css": ".ds-status{font-family:var(--font-body,-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif);font-size:13px;display:inline-block;font-size:11px;border-radius:5px;padding:3px 7px;background:var(--lc-warning-soft,#fff5df);color:var(--lc-warning,#94600c);font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Task surface",
      "kind": "card",
      "refersTo": "task-surface",
      "description": "生产上下文中带边界的平面任务容器。",
      "html": "<section class=\"ds-task\"><h3 class=\"ds-task-title\">本期配置</h3><dl class=\"ds-task-facts\"><dt>蓝图版本</dt><dd>v1</dd><dt>审核修订</dt><dd>v2</dd></dl></section>",
      "css": ".ds-task{font-family:var(--font-body,-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif);font-size:13px;max-width:300px;padding:20px;background:var(--lc-surface,#fff);color:var(--lc-ink,#17263e);border:1px solid var(--lc-line,#d8e1ee);border-radius:12px}.ds-task-title{font-size:14px;font-weight:650;margin:0 0 15px}.ds-task-facts{display:grid;grid-template-columns:1fr auto;gap:13px;font-size:12px;margin:0;font-variant-numeric:tabular-nums}.ds-task-facts dt{color:var(--lc-muted,#596b83)}.ds-task-facts dd{margin:0}"
    },
    {
      "name": "Continuous phase track",
      "kind": "custom",
      "refersTo": "phase-track",
      "description": "当前处于真实待决阶段的七段只读轨迹外观。",
      "html": "<ol class=\"ds-track\" aria-label=\"生产阶段\"><li class=\"ds-phase ds-past\"><span class=\"ds-node\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span><strong>输入与脚本</strong></li><li class=\"ds-phase ds-past\"><span class=\"ds-node\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span><strong>视觉准备</strong></li><li class=\"ds-phase ds-past\"><span class=\"ds-node\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span><strong>分镜审核</strong></li><li class=\"ds-phase ds-past\"><span class=\"ds-node\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span><strong>逐镜头制作</strong></li><li class=\"ds-phase ds-past\"><span class=\"ds-node\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span><strong>预渲染审核</strong></li><li class=\"ds-phase ds-current\" aria-current=\"step\"><span class=\"ds-node\">6</span><strong>合成与 QC</strong></li><li class=\"ds-phase\"><span class=\"ds-node\">7</span><strong>交付</strong></li></ol>",
      "css": ".ds-track{font-family:var(--font-body,-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif);font-size:13px;display:flex;gap:0;list-style:none;padding:0;margin:0;overflow-x:auto;background:var(--lc-bg,#eef2f8)}.ds-phase{position:relative;display:grid;justify-items:center;gap:9px;flex:1;min-width:max-content;padding:12px 10px 14px;font-size:12px;color:var(--lc-muted,#596b83)}.ds-phase:not(:last-child)::after{content:\"\";position:absolute;top:22px;left:calc(50% + 15px);width:calc(100% - 30px);height:1px;background:var(--lc-line-strong,#bdcadd)}.ds-node{position:relative;z-index:1;width:21px;height:21px;border:1px solid var(--lc-line-strong,#bdcadd);border-radius:50%;display:grid;place-items:center;font-size:10px;background:var(--lc-bg,#eef2f8)}.ds-phase strong{font-weight:500}.ds-past{color:var(--lc-success,#167556)}.ds-past:not(:last-child)::after{background:var(--lc-success,#167556)}.ds-past .ds-node{border-color:var(--lc-success,#167556);background:var(--lc-success-soft,#e9f5ef)}.ds-current{color:var(--lc-warning,#94600c)}.ds-current .ds-node{background:var(--lc-warning,#94600c);border-color:var(--lc-warning,#94600c);color:var(--lc-primary-ink,#fff)}.ds-current strong{font-weight:650}"
    },
    {
      "name": "Long table name",
      "kind": "custom",
      "refersTo": "table-name",
      "description": "两行正文保留行高；真实应用使用 React Aria Tooltip 与原行打开处理函数。",
      "html": "<button class=\"ds-table-name\" title=\"跨账号与系列的生产单完整名称，保留必要上下文和版本信息\"><span class=\"ds-table-text\">跨账号与系列的生产单完整名称，保留必要上下文和版本信息</span></button>",
      "css": ".ds-table-name{font-family:var(--font-body,-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif);font-size:13px;display:block;max-width:240px;width:100%;padding:0;border:0;border-radius:2px;background:transparent;color:var(--lc-ink,#17263e);text-align:left;font-weight:600;cursor:pointer}.ds-table-text{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere;line-height:1.5;max-height:3em}.ds-table-name:hover{background:var(--lc-accent-soft,#eaf0ff)}.ds-table-name:focus-visible{outline:2px solid var(--lc-accent,#365fe0);outline-offset:3px;}"
    },
    {
      "name": "Button / primary dark",
      "kind": "button",
      "refersTo": "button-primary-dark",
      "description": "深色主题主按钮：语义文字墨色与图标一致。",
      "html": "<div class=\"ds-dark-surface\"><button class=\"ds-dark-button\" type=\"button\">批准</button></div>",
      "css": ".ds-dark-surface{--lc-surface:#1a283c;--lc-accent:#87a6ff;--lc-accent-hover:#a3baff;--lc-primary-ink:#102145;background:var(--lc-surface);padding:20px}.ds-dark-button{font-family:var(--font-body,-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif);font-size:13px;border-radius:7px;padding:8px 12px;font-weight:600;line-height:20px;cursor:pointer;transition:background-color .15s,color .15s,border-color .15s;background:var(--lc-accent);color:var(--lc-primary-ink);border:1px solid transparent}.ds-dark-button:hover{background:var(--lc-accent-hover)}.ds-dark-button:focus-visible{outline:2px solid var(--lc-accent);outline-offset:3px}.ds-dark-button:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-dark-button{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "连续制作轨迹",
    "overview": "以连续制作轨迹组织工作：冷蓝灰底色承托任务，钴蓝侧栏维持位置，白色或深蓝表面承载真实操作。界面保持紧凑，让当前生产单、下一步、审核与冻结配置处于同一上下文。\n\n桌面工作区采用系统无衬线字体、对齐列表与克制的层级。绿色表示已走过的阶段，琥珀色表示真实待决事项；蓝色负责操作、选择和当前阶段。颜色始终伴随文本、图标或语义状态。",
    "keyCharacteristics": [
      "冷蓝灰工作底色与固定钴蓝导航。",
      "紧凑控件、对齐列表、完整生产上下文。",
      "连续阶段轨迹连接当前任务、审核与交付。",
      "浅色与深色共用语义角色；焦点和窄窗行为可用。"
    ],
    "rules": [
      {
        "name": "Semantic Theme",
        "body": "主题切换通过语义变量与采用控件的别名完成；主按钮文字和图标一并使用 primary-ink。",
        "section": "colors"
      },
      {
        "name": "Status Has Meaning",
        "body": "阶段颜色来自真实阶段与待决状态，不能用装饰色暗示已完成、待审核或拥有操作权限。",
        "section": "colors"
      },
      {
        "name": "Flat Task Surface",
        "body": "常规任务表面以底色、边界与留白分层；阴影用于浮层，不用悬浮感区分普通任务的重要性。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 沿用语义主题变量，并检查主按钮文字与图标在两个主题下的可读性。",
      "Do 保持列表与生产详情的返回上下文；长名称用两行截断和可聚焦 Tooltip 展示全文。",
      "Do 让阶段轨迹、审核状态与实际 API 数据一致，保留当前阶段的语义标记。",
      "Do 为窄窗折叠导航、堆叠面板和表单；保留可访问名称、必要错误与可见焦点。",
      "Do 优先使用已有 React Aria 控件、真实处理函数与注册的配置目录。"
    ],
    "donts": [
      "Don't 把阶段轨迹做成可以绕过业务审核的可点击步骤。",
      "Don't 把原型的模拟媒体、假凭据、假导出或虚构列表带入原生运行时。",
      "Don't 给正常任务容器叠加阴影、重复卡片和无关统计，削弱当前操作的层级。",
      "Don't 为缩短界面隐藏必要的字段语义、审批理由、阻塞错误或历史只读状态。",
      "Don't 把设计文档和视觉截图当作全部业务集成测试已通过的证据。"
    ]
  }
}
