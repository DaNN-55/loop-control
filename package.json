{
  "name": "loop-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs",
    "dev:local": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "stop:all": "node scripts/stop.mjs",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:openchatcut-integration": "vitest run src/worker/openchatcutProject.integration.test.ts",
    "test:watch": "vitest --exclude '**/*.integration.test.ts'",
    "test:e2e": "node scripts/e2e/run.mjs",
    "worker:build": "tsc -p tsconfig.worker.json",
    "worker:execute": "node scripts/run-prepared.mjs worker",
    "worker:run": "npm run worker:execute --",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "runtime:migrate": "node scripts/runtime/migrate.mjs",
    "secrets:list": "node scripts/runtime/secrets.mjs",
    "secrets:copy": "node scripts/runtime/secrets.mjs --copy",
    "ui:build": "node scripts/build-dan-ui.mjs",
    "backend:build": "tsc -p tsconfig.local-app.json"
  },
  "dependencies": {
    "@untitledui/icons": "0.0.23",
    "@videojs/react": "10.2.0",
    "lucide-react": "^1.31.0",
    "pg": "8.23.1",
    "react": "^19.1.1",
    "react-aria-components": "1.21.1",
    "react-dom": "^19.1.1",
    "react-range": "^1.10.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "tailwindcss-react-aria-components": "2.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
