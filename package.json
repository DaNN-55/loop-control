{
  "name": "loop-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node scripts/local/start.mjs",
    "dev": "node scripts/local/start.mjs",
    "dev:local": "node scripts/local/start.mjs",
    "stop": "node scripts/local/stop.mjs",
    "stop:all": "node scripts/local/stop.mjs",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test": "vitest run --exclude n8n/import-workflows.test.mjs --exclude '**/*.integration.test.ts' && node --test n8n/import-workflows.test.mjs",
    "test:openchatcut-integration": "vitest run src/worker/openchatcutProject.integration.test.ts",
    "test:watch": "vitest --exclude n8n/import-workflows.test.mjs --exclude '**/*.integration.test.ts'",
    "worker:build": "tsc -p tsconfig.worker.json",
    "worker:execute": "node scripts/run-prepared.mjs worker",
    "worker:run": "npm run worker:execute --",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "publish:prepare": "node scripts/local/retired-command.mjs publish:prepare",
    "publish:register-input": "node scripts/local/retired-command.mjs publish:register-input",
    "publish:verify": "node scripts/local/retired-command.mjs publish:verify",
    "orchestrator:build": "tsc -p tsconfig.orchestrator.json",
    "orchestrator:run": "node scripts/run-prepared.mjs orchestrator",
    "db:migrations:check": "node scripts/supabase-migrations.mjs",
    "db:migrations:deploy": "node scripts/supabase-migrations.mjs --deploy",
    "isolated:init": "node scripts/isolation/run.mjs init",
    "isolated:start": "node scripts/isolation/run.mjs start",
    "isolated:stop": "node scripts/isolation/run.mjs stop",
    "isolated:status": "node scripts/isolation/run.mjs status",
    "test:isolation": "vitest run scripts/isolation/*.test.mjs",
    "isolated:database": "node scripts/isolation/database.mjs",
    "isolated:smoke": "node scripts/isolation/smoke.mjs",
    "isolated:baseline": "npm run worker:build && node scripts/isolation/baseline.mjs",
    "isolated:test": "node scripts/isolation/run.mjs test",
    "isolated:stage-b": "node scripts/isolation/stage-b.mjs",
    "isolated:backup": "node scripts/isolation/backup.mjs",
    "isolated:restore": "node scripts/isolation/restore.mjs",
    "isolated:restore-fixture": "node scripts/isolation/restore-fixture.mjs",
    "isolated:restore-verify": "node scripts/isolation/restore-verify.mjs",
    "isolated:leases": "node scripts/isolation/leases.mjs",
    "isolated:worker-recovery": "node scripts/isolation/worker-recovery.mjs",
    "isolated:stage-b-audit": "node scripts/isolation/stage-b-audit.mjs",
    "isolated:sql-tests": "node scripts/isolation/sql-tests.mjs",
    "local:prepare": "node scripts/local/prepare.mjs",
    "local:prepare-offline": "node scripts/local/prepare-offline.mjs",
    "local:prepare-providers": "node scripts/local/provider-network-prepare.mjs",
    "local:import": "node scripts/local/restore.mjs --verified",
    "local:start": "node scripts/local/start.mjs",
    "local:stop": "node scripts/local/stop.mjs",
    "local:check": "node scripts/local/check.mjs",
    "legacy:start": "LOOP_LEGACY_RUNTIME=1 node scripts/start-local.mjs",
    "legacy:dev": "vite --mode legacy",
    "legacy:stop": "./scripts/stop-all.sh",
    "legacy:worker": "node scripts/run-prepared.mjs legacy-worker",
    "legacy:orchestrator": "node scripts/run-prepared.mjs legacy-orchestrator",
    "legacy:publish:prepare": "npm run worker:build && node dist/worker/publishing/publishPackageCli.js",
    "legacy:publish:register-input": "npm run worker:build && node dist/worker/publishing/publishInputCli.js",
    "legacy:publish:verify": "npm run worker:build && node dist/worker/publishing/publishPackageVerifyCli.js"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "pg": "8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-range": "^1.10.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "supabase": "^2.117.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "@supabase/supabase-js": "^2.57.0"
  }
}
