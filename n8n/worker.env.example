# 本文件只作变量说明；复制为 worker.env.local 后填写，后者不会提交到 Git。
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CODEX_WORKER_ACTUAL_COST_CENTS=0
CODEX_WORKER_CAPACITY=2
LOOP_WORKER_CONCURRENCY=2
# 修改后运行 n8n/import-workflows.sh 使本机定时器生效。
LOOP_DISPATCH_INTERVAL_MINUTES=15
LOOP_NOTIFICATION_INTERVAL_MINUTES=30
N8N_RUNNERS_BROKER_PORT=5679
OPENCHATCUT_ROOT=/absolute/path/to/OpenChatCut
OPENCHATCUT_NODE=/opt/homebrew/opt/node@24/bin/node
MEDIA_LIBRARY_MOUNT_PATH=/Volumes/Media
MEDIA_LIBRARY_MIN_FREE_BYTES=21474836480
PEXELS_API_KEY=
GOOGLE_TTS_API_KEY=
FREESOUND_API_KEY=
